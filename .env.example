# FrontCanvas — 环境变量清单
#
# 真实值**不进 git**（连私有仓库也不进）。这份文件只是清单：
# 告诉未来的你需要哪些变量、各自去哪儿拿。
#
# ── 换机还原（最快路径）──────────────────────────────
#   git clone git@github.com:haohuazheng3/frontcanvas-private.git
#   cd frontcanvas-private && npm install
#   npx vercel link          # 关联到 frontcanvas 项目
#   npx vercel env pull .env.local
#   npm run migrate          # 幂等，可重复跑
#
# Vercel 才是密钥的权威来源 —— 生产在用的就是那一份。
# 把密钥提交进 git（哪怕私有）反而更危险：仓库可能误转公开、
# 协作者与第三方 Action 都读得到、GitHub 侧也有一份拷贝。
# 详细的「每个密钥去哪个后台拿」见 account.md。

# ── 数据库（Neon）──────────────────────────────────
# 必须是 pooled 连接串（host 含 -pooler），serverless 直连会耗尽连接
DATABASE_URL=

# ── 站点 ────────────────────────────────────────────
APP_DOMAIN=frontcanvas.com
APP_URL=https://frontcanvas.com
NEXT_PUBLIC_APP_URL=https://frontcanvas.com
BRAND_NAME=FrontCanvas
NEXT_PUBLIC_INDEXABLE=1

# ── Cloudflare（DNS / R2）───────────────────────────
CLOUDFLARE_API_TOKEN=
CF_ACCOUNT_ID=
CF_ZONE_ID=
R2_BUCKET=frontcanvas

# ── Clerk（仅邮箱验证码登录）─────────────────────────
# 注意：production 实例从 clerk.<域名> 加载 JS，CSP 要放行
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-in

# ── Stripe（live）───────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── 发信（Google Workspace SMTP）────────────────────
# SMTP_PASS 是应用专用密码，不是登录密码
# From 用别名 contact@ 时，必须先在 Gmail → Send mail as 里登记
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=hello@frontcanvas.com
SMTP_PASS=
MAIL_FROM=contact@frontcanvas.com
MAIL_REPLY_TO=contact@frontcanvas.com
POSTAL_ADDRESS=4855 Bridle Run, Ypsilanti, MI 48197

# ── 自建密钥（丢了自己重新生成即可）──────────────────
ADMIN_SECRET=
CRON_SECRET=
UNSUB_SECRET=

# ── 分析与性能 ──────────────────────────────────────
FLOWGLANCE_API=
FLOWGLANCE_DATA_TOKEN=
PSI_API=

# ── SEO 自动化 ──────────────────────────────────────
GOOGLE_SERVICE_ACCOUNT_B64=

# /admin 登录口令（人用的；机器端点仍走 ADMIN_SECRET）
ADMIN_PASSWORD=
